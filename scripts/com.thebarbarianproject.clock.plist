<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.thebarbarianproject.clock</string>

  <!-- NOT INSTALLED. The Cloudflare clock (worker/clock) is what runs the
       schedule; this is the spare for the day it stops again, and running both
       dispatches every slot twice. To take over:
         install -m 644 scripts/com.thebarbarianproject.clock.plist \
           ~/Library/LaunchAgents/com.thebarbarianproject.clock.plist
         launchctl bootstrap gui/$(id -u) \
           ~/Library/LaunchAgents/com.thebarbarianproject.clock.plist
       and delete the Cloudflare cron trigger first. To stand down:
         launchctl bootout gui/$(id -u)/com.thebarbarianproject.clock
         rm ~/Library/LaunchAgents/com.thebarbarianproject.clock.plist -->

  <!-- Both the script and the JavaScript it runs sit outside ~/Documents,
       which macOS refuses a launchd agent access to: pointing at the copies in
       the repository fails with "Operation not permitted" and exit 126 before
       the script starts, leaving nothing in the job log to debug from.
       Reinstall all three after editing the canonical copies —
         install -m 755 scripts/clock_local.sh \
           ~/Library/Application\ Support/esthmr/clock_local.sh
         install -m 644 scripts/clock_tick.mjs \
           ~/Library/Application\ Support/esthmr/clock_tick.mjs
         install -m 644 worker/clock/src/index.js \
           ~/Library/Application\ Support/esthmr/clock.js -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/barbary/Library/Application Support/esthmr/clock_local.sh</string>
  </array>

  <!-- Every fifteen minutes, which is what `publish-live-data` asks for and the
       granularity every other slot in SCHEDULE is a multiple of.

       StartInterval rather than the harvest's list of StartCalendarInterval
       entries, because the times themselves live in JavaScript here: the agent
       only has to wake often enough, and `dueAt()` decides what is actually due
       in Cairo terms. That also means a DST change needs no edit to this file.

       An interval timer does not fire while the machine is asleep, and launchd
       runs a missed interval once on wake rather than catching up on each one.
       That is the right behaviour for a clock — a burst of six stale
       dispatches at 08:00 helps nobody — and it is why the watchdog inside the
       tick matters: the first tick after waking is what notices the publishes
       that were missed. -->
  <key>StartInterval</key>
  <integer>900</integer>

  <!-- Run one immediately on load and on login, so installing it or opening the
       laptop does not wait a quarter of an hour to find out whether it works.
       The tick is idempotent: `busy()` and the workflows' own concurrency
       groups make a duplicate dispatch a queued run, not a second publish. -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/barbary/Library/Logs/esthmr-clock.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/barbary/Library/Logs/esthmr-clock.launchd.log</string>

  <!-- A background errand: a handful of API calls, and nothing anybody is
       waiting on this machine for. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
